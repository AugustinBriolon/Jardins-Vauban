# Variables d'environnement — Les Jardins de Vauban
# Copiez ce fichier en .env.local et remplissez les valeurs réelles

# ─── Airtable ────────────────────────────────────────────────────────────────
# 1. Créez un compte sur https://airtable.com
# 2. Créez une base nommée "Jardins de Vauban"
# 3. Créez deux tables : "Lots" et "Demandes" (voir README.md pour la structure)
# 4. Générez un Personal Access Token sur https://airtable.com/create/tokens
#    Scopes nécessaires : data.records:read  data.records:write
# 5. Copiez l'ID de base depuis l'URL Airtable : https://airtable.com/appXXXXXX

AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ─── Site ─────────────────────────────────────────────────────────────────────
# URL publique (utilisée pour les balises Open Graph)
NEXT_PUBLIC_SITE_URL=https://jardins-de-vauban.vercel.app

# ─── Instant updates (Airtable webhook) ───────────────────────────────────────
# Printed by: npx ts-node --skip-project scripts/create-webhook.ts https://<site>/api/airtable-webhook
# (the token needs the webhook:manage and data.records:read scopes)
AIRTABLE_WEBHOOK_ID=achXXXXXXXXXXXXXX
AIRTABLE_WEBHOOK_MAC_SECRET=base64-secret-from-airtable
# Field id of "Référence", used to rebuild only the page of the lot that changed
AIRTABLE_REFERENCE_FIELD_ID=fldXXXXXXXXXXXXXX
# Protects /api/cron/refresh-webhook (Vercel sends it automatically on cron calls)
CRON_SECRET=a-long-random-string
